.page { background: #f5f6fa; min-height: 100vh; padding-bottom: 180rpx; }

.form-container { padding: 24rpx 24rpx 0; }

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 36rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.card-title { font-size: 30rpx; font-weight: bold; color: #1a1a1a; }

.form-item { margin-bottom: 28rpx; }
.form-item:last-child { margin-bottom: 0; }

.form-label {
  font-size: 26rpx; color: #555; font-weight: 500;
  margin-bottom: 12rpx; display: flex; align-items: center; gap: 6rpx;
}
.required { color: #ff4d4f; font-size: 28rpx; }

.form-input {
  width: 100%; height: 84rpx;
  background: #f7f8fb; border-radius: 14rpx;
  padding: 0 24rpx; font-size: 28rpx; color: #222;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.form-input:focus { border-color: #1677ff; background: #fff; }

.location-picker {
  width: 100%; min-height: 84rpx;
  background: #f7f8fb; border-radius: 14rpx;
  padding: 0 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-sizing: border-box;
}
.location-text { font-size: 28rpx; color: #222; flex: 1; line-height: 1.5; padding: 18rpx 0; }
.location-text.placeholder { color: #bbb; }
.location-icon { font-size: 26rpx; color: #1677ff; font-weight: 500; margin-left: 16rpx; flex-shrink: 0; }

.type-grid {
  display: flex; flex-wrap: wrap; gap: 14rpx;
}
.type-item {
  padding: 14rpx 28rpx;
  background: #f7f8fb;
  border-radius: 40rpx;
  font-size: 26rpx; color: #666;
  border: 2rpx solid transparent;
}
.type-item.active {
  background: #e8f3ff; color: #1677ff;
  border-color: #1677ff;
}

.form-textarea {
  width: 100%; height: 160rpx;
  background: #f7f8fb; border-radius: 14rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; color: #222;
  box-sizing: border-box;
}

.submit-area {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff;
  padding: 20rpx 32rpx env(safe-area-inset-bottom, 32rpx);
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.07);
}
.submit-btn {
  width: 100%; height: 96rpx;
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #fff;
  border-radius: 48rpx; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(22,119,255,0.3);
}
.submit-btn[disabled] {
  background: #d0d0d0; box-shadow: none;
}
.submit-tip {
  display: block; text-align: center;
  font-size: 22rpx; color: #aaa; margin-top: 12rpx;
}
.price-input-wrap {
  display: flex; align-items: center; gap: 16rpx;
}
.price-input { flex: 1; }
.price-unit { font-size: 28rpx; color: #888; white-space: nowrap; flex-shrink: 0; }
