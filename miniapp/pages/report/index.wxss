.page { background: #f4f6f9; min-height: 100vh; padding-bottom: 160rpx; }

.form-container { padding: 24rpx; }

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 32rpx;
}
.card-title { font-size: 32rpx; font-weight: bold; color: #1a1a1a; }

.form-item { margin-bottom: 32rpx; }
.form-item:last-child { margin-bottom: 0; }

.form-label {
  font-size: 28rpx; color: #333; font-weight: 500;
  margin-bottom: 16rpx; display: block;
}
.required { color: #ff4d4f; }

.form-input {
  width: 100%; height: 88rpx;
  background: #f4f6f9; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 28rpx; color: #222;
}

.location-picker {
  width: 100%; height: 88rpx;
  background: #f4f6f9; border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.location-text { font-size: 28rpx; color: #222; }
.location-text.placeholder { color: #bbb; }
.location-icon { font-size: 32rpx; color: #1677ff; }

.type-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.type-item {
  padding: 16rpx 32rpx;
  background: #f4f6f9; border-radius: 12rpx;
  font-size: 26rpx; color: #666;
}
.type-item.active {
  background: #1677ff; color: #fff;
}

.form-textarea {
  width: 100%; height: 200rpx;
  background: #f4f6f9; border-radius: 12rpx;
  padding: 24rpx; font-size: 28rpx; color: #222;
}

.submit-area {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff;
  padding: 24rpx 32rpx 48rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}
.submit-btn {
  width: 100%; height: 96rpx;
  background: #1677ff; color: #fff;
  border-radius: 20rpx; font-size: 32rpx; font-weight: 500;
  display: flex; align-items: center; justify-content: center;
}
.submit-btn[disabled] {
  background: #ccc;
}
.submit-tip {
  display: block; text-align: center;
  font-size: 24rpx; color: #999; margin-top: 16rpx;
}
