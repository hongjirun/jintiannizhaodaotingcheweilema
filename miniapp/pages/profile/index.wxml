<view class="page">

  <view class="section">
    <view class="section-title">功能服务</view>
    <view class="menu-list">
      <view wx:if="{{reportEnabled}}" class="menu-item" bindtap="goToReport">
        <text class="menu-icon">P</text>
        <text class="menu-label">免费停车点位上报</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="joinGroup">
        <text class="menu-icon">G</text>
        <text class="menu-label">加入群聊</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>


  <!-- 底部说明 -->
  <view class="footer">
    <text class="footer-text">数据来源：腾讯位置服务</text>
    <text class="footer-text">停车场信息仅供参考，以现场为准</text>
  </view>
</view>
